# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo a .env.local y completá los valores.
# Nada de lo que hay acá puede tener prefijo NEXT_PUBLIC_: son secretos de servidor.
# ─────────────────────────────────────────────────────────────────────────────

# --- Postgres (los usa docker-compose y la app) ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_dev
POSTGRES_DB=crm
POSTGRES_PORT=5432
REDIS_PORT=6379

# Cadena de conexión que usa Drizzle y la app.
# Docker local:  postgres://crm:crm_local_dev@localhost:5432/crm
# Supabase:      postgres://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://crm:crm_local_dev@localhost:5432/crm

# Poné true si la base exige TLS (Supabase, Neon, RDS). En Docker local, false.
DATABASE_SSL=false

# --- Autenticación ---
# Generalo con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Cifrado de credenciales guardadas en la base ---
# Con esta clave se cifran el token de la API de Chatwoot y los tokens de
# instancia de Evolution (AES-256-GCM). Si la perdés, hay que volver a cargar
# esas credenciales desde Configuración. Nunca la pongas en un NEXT_PUBLIC_.
# Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Operación ---
# Zona horaria para cupos, reinicios de contador y ventanas horarias.
OPS_TIMEZONE=America/Argentina/Catamarca

# --- Módulo de setters (Instagram desde el celular) ---
#
# Notificaciones push de la PWA. Sin estas claves el push queda apagado: el
# botón de "activar avisos" no aparece y los recordatorios llegan igual como
# cartel al abrir la app. Generalas con:
#
#   npm run push:claves
#
# Si las regenerás, todos los setters tienen que volver a activar los avisos en
# su celular.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vos@tudominio.com

# Secreto de /api/tareas, la ruta que dispara los recordatorios automáticos, el
# resumen del día y las alertas de atraso. La llama un programador externo cada
# 10-15 minutos:
#
#   curl -H "Authorization: Bearer $TAREAS_SECRET" https://.../api/tareas
#
# Sin este valor la ruta no atiende a nadie. El vencimiento de leads NO depende
# de esto: se resuelve al abrir la cola, así que el sistema funciona igual sin
# programador; lo que se pierde son los avisos que llegan solos.
TAREAS_SECRET=

# Base de los tests de integración. Si no está, se usa <DATABASE_URL>_test.
# TEST_DATABASE_URL=postgres://crm:crm_local_dev@localhost:5432/crm_test

# --- Modo prueba ---
#
# Muestra en /ingresar botones para entrar de un toque, sin contraseña, con las
# cuentas de demostración (`npm run demo:setters`). Sirve para recorrer la app
# saltando de rol a rol mientras se prueba.
#
# Está cerrado con tres llaves: no funciona con NODE_ENV=production, hay que
# encenderlo a mano acá, y solo deja entrar a cuentas @demo.local que no sean la
# cuenta madre. Igual: NO lo pongas en el servidor.
MODO_PRUEBA=false

# --- Parte 2 (todavía sin uso) ---
REDIS_URL=redis://localhost:6379

# Chatwoot es la bandeja: recibe las conversaciones de las 10 instancias y la
# consola se sincroniza por webhook. La URL base, el id de cuenta, el token y el
# secreto del webhook se cargan desde Configuración y se guardan cifrados en la
# base, no acá.
#
# Evolution queda por debajo de Chatwoot. La consola solo le habla directo como
# respaldo, si Chatwoot no responde.
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
